---
import type { CollectionEntry } from 'astro:content';
import { getStars, formatStars } from '../lib/github';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'large' | 'small';
}

const { project, size = 'small' } = Astro.props;
const { title, tagline, repo, tags, image, imageAlt, imageFit, stars: fallback } = project.data;
const stars = (await getStars(repo)) ?? fallback;
const hasPage = Boolean(project.body?.trim());
const href = hasPage ? `/projects/${project.id}/` : `https://github.com/${repo}`;
---

<article class:list={['card', `card--${size}`]}>
  {
    size === 'large' && image && (
      <div class:list={['card-media', `card-media--${imageFit}`]}>
        <img src={image} alt={imageAlt ?? ''} loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="card-body">
    <h3>
      <a href={href} class="card-link">{title}</a>
    </h3>
    <p>{tagline}</p>
    <div class="card-meta">
      {stars > 0 && <span class="stars" aria-label={`${stars} GitHub stars`}>★ {formatStars(stars)}</span>}
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
</article>
