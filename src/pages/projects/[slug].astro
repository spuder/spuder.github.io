---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getStars, formatStars } from '../../lib/github';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.body?.trim())
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, tagline, repo, tags, image, imageAlt, video, links, stars: fallback } = project.data;
const stars = (await getStars(repo)) ?? fallback;
const { Content } = await render(project);
---

<Base title={title} description={tagline} image={image}>
  <article class="wrap project">
    <p class="eyebrow"><a href="/projects/">Projects</a></p>
    <h1>{title}</h1>
    <p class="lede">{tagline}</p>
    <div class="card-meta">
      {stars > 0 && <span class="stars">★ {formatStars(stars)} on GitHub</span>}
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    <p class="hero-links">
      <a class="button button--primary" href={`https://github.com/${repo}`}>View on GitHub</a>
      {links.map((l) => <a class="button" href={l.url}>{l.label}</a>)}
    </p>

    {
      video ? (
        <video class="project-media" src={video} poster={image} autoplay muted loop playsinline aria-label={imageAlt} />
      ) : (
        image && <img class="project-media" src={image} alt={imageAlt ?? ''} />
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
